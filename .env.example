# VYNORA PLATFORM ENVIRONMENT CONFIGURATION
NODE_ENV=development
PORT=8787
CLIENT_URL=http://localhost:5173

# DATABASE CONFIGURATION
# Local MongoDB: mongodb://127.0.0.1:27017/vynora
# Production Atlas: mongodb+srv://<username>:<password>@cluster0.mongodb.net/vynora?retryWrites=true&w=majority
MONGODB_URI=mongodb://127.0.0.1:27017/vynora

# AUTHENTICATION & SECURITY
SESSION_SECRET=vynora_session_secret_change_in_production
JWT_SECRET=vynora_jwt_secret_change_in_production
ADMIN_BOOTSTRAP_KEY=vynora_admin_init_2026

# GOOGLE OAUTH 2.0 (Google Identity Services)
GOOGLE_CLIENT_ID=your-google-oauth-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-oauth-client-secret

# OPTIONAL PAYMENT INTEGRATION (Razorpay / Stripe)
PAYMENT_PROVIDER=simulator
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# EMAIL / NOTIFICATION PROVIDER
EMAIL_PROVIDER=console
EMAIL_FROM="Vynora Campus <notifications@vynora.edu>"

# FILE STORAGE
STORAGE_PROVIDER=local
UPLOAD_DIR=./uploads
